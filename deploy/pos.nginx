# ==============================================================================
# Nginx VirtualHost para DevSLa POS (pos.devsla.cl)
# Compatible con Cloudflare (SSL Flexible / Full / Full Strict) y WebSockets
# ==============================================================================

# Redirección HTTP -> HTTPS (o gestión de Cloudflare)
server {
    listen 80;
    listen [::]:80;
    server_name pos.devsla.cl;

    client_max_body_size 50M;

    # Archivos estáticos de Django servidos a alta velocidad
    location /static/ {
        alias /var/www/pos/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # Proxy hacia Gunicorn en puerto interno 127.0.0.1:8001
    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;

        # Soporte completo para WebSockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Cabeceras de Proxy y soporte de Cloudflare
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Captura de IP real si el tráfico viene a través de Cloudflare
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;

        # Timeouts para operaciones de POS y reportes
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
